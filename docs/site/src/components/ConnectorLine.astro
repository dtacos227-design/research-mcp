<!-- SVG connector that runs the full height of its parent container.
     The line stroke-dashoffset is animated by initCaraKerjaAnimation(). -->
<svg id="connector-svg"
  class="absolute top-0 pointer-events-none"
  style="left: 1.25rem; width: 2px; height: 100%; overflow: visible;">
  <line id="connector-path"
    x1="1" y1="0"
    x2="1" y2="100%"
    stroke="#C4954A"
    stroke-width="2"
    stroke-dasharray="2000"
    stroke-dashoffset="2000"
  />
</svg>
