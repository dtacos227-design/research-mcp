---
interface Props {
  quoteId: string
  quoteEn: string
}
const { quoteId, quoteEn } = Astro.props
---

<blockquote class="my-10 pl-6 py-2"
  style="border-left: 4px solid #C4954A;">
  <p class="font-mono text-lg md:text-xl leading-snug"
    style="color: #1E130F;"
    data-id={quoteId}
    data-en={quoteEn}>
    {quoteId}
  </p>
</blockquote>
